# Layer better-gather-odf's collection scripts onto an existing ODF
# must-gather image.
#
# The upstream Dockerfile builds from registry.ci.openshift.org, which needs
# CI credentials. For testing against a real cluster it is simpler and more
# faithful to overlay onto the image that cluster's ODF operator already
# advertises, so the base is version-matched and pullable:
#
#   make image-overlay BASE=$(oc get csv -n openshift-storage \
#       -o jsonpath='{.items[?(@.metadata.name=="ocs-operator.v4.18.29-rhodf")]...}')
#
# Note this image deliberately has no jq (see the upstream Dockerfile), so
# trim_jsonl_since is a no-op here. ODF collects no JSON-lines audit logs, so
# nothing depends on it.

ARG BASE=registry.redhat.io/odf4/odf-must-gather-rhel9:latest
FROM ${BASE}

COPY collection-scripts/ /usr/bin/

LABEL io.k8s.display-name="better-gather-odf" \
      io.k8s.description="ODF must-gather collection scripts that honour --since"
