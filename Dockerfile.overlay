# Layer better-gather-odf's collection scripts onto an existing ODF
# must-gather image.
#
# BASE is deliberately not defaulted. This image adds nothing but shell
# scripts -- no packages, no binaries -- so every CVE it carries comes from
# whatever it is layered on, and a default would be the wrong answer most of
# the time. quay.io/ocs-dev/ocs-must-gather:latest was built 2025-07-02 and
# has no fresher tag; building on it is how a scan ends up far worse than a
# stock must-gather. The supported image,
# registry.redhat.io/odf4/odf-must-gather-rhel9, needs a subscription, and
# upstream's own Dockerfile builds from registry.ci.openshift.org, which
# needs CI credentials.
#
# The right base is the image your cluster already runs, which carries
# exactly the CVEs you have already accepted and nothing more:
#
#   oc get csv -n openshift-storage -o json \
#     | jq -r '..|.["operators.openshift.io/must-gather-image"]? // empty'
#
#   make image-overlay BASE=<that image>
#
# Failing that, build a current one from UBI9 -- see Dockerfile.base:
#
#   make image-base
#   make image-overlay BASE=better-gather-odf-base:latest
#
# Note the supported ODF image deliberately ships no jq (see the upstream
# Dockerfile), so trim_jsonl_since is a no-op when layered onto it. ODF
# collects no JSON-lines audit logs, so nothing depends on it. Dockerfile.base
# does install jq, since gather_ceph_resources uses it.
#
# Either way the result is labelled with the base it used and when that base
# was built, so it is never a mystery what a scan is actually reporting on.

ARG BASE
FROM ${BASE}

COPY collection-scripts/ /usr/bin/

# In the overlay rather than the base, so it travels onto whatever image you
# layer onto. gather prints it and copies it into every collection.
COPY DISCLAIMER /usr/share/better-gather-odf/DISCLAIMER

ARG BASE
ARG BASE_BUILT="unknown"
LABEL io.k8s.display-name="better-gather-odf" \
      io.k8s.description="Unofficial ODF must-gather collection scripts that honour --since. Not a Red Hat product." \
      better-gather.base="${BASE}" \
      better-gather.base-built="${BASE_BUILT}" \
      better-gather.disclaimer="Not a Red Hat product: unofficial fork of red-hat-storage/odf-must-gather, unsupported, no warranty. See /usr/share/better-gather-odf/DISCLAIMER" \
      org.opencontainers.image.title="better-gather-odf" \
      org.opencontainers.image.description="Unofficial fork of red-hat-storage/odf-must-gather in which --since bounds what is collected. Not a Red Hat product." \
      org.opencontainers.image.vendor="dsedgmen (unofficial -- not Red Hat)" \
      org.opencontainers.image.source="https://github.com/dsedgmen/better-gather-odf" \
      org.opencontainers.image.licenses="Apache-2.0"
